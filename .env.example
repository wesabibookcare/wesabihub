# --- BACKEND SECRETS (SERVER-SIDE ONLY) ---
# DO NOT PREFIX WITH VITE_

# Firebase Admin Service Account (JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Maps Platform (Server-side proxy key)
GOOGLE_MAPS_PLATFORM_KEY=

# Flutterwave Payment Gateway
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Gemini AI Integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- FRONTEND CONFIG (PUBLICLY VISIBLE) ---
# MUST PREFIX WITH VITE_

# Google Maps Platform (Frontend restrictions applied)
VITE_GOOGLE_MAPS_API_KEY=

# Flutterwave Public Key
VITE_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-MOCK-1234567890"

# Paystack Public Key
VITE_PAYSTACK_PUBLIC_KEY=

# Application Identity
VITE_APP_NAME="OmorfiHub"
VITE_APP_URL="MY_APP_URL"
