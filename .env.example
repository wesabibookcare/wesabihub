# ====================================================================
# OMORFIHUB ENVIRONMENT CONFIGURATION
# ====================================================================
# Note: Variables prefixed with VITE_ are bundled into the browser client.
# Server secrets MUST NOT have the VITE_ prefix.

# --- BACKEND SECRETS (SERVER-SIDE ONLY) ---
# Required for privileged operations, admin actions, and webhooks.

# Firebase Admin Service Account (JSON string or path to service account)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Maps Platform (Server-side proxy key with elevated quotas)
GOOGLE_MAPS_PLATFORM_KEY=

# Flutterwave Payment Gateway (Server-side secret key and webhook hash)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Paystack Payment Gateway (Server-side secret key)
PAYSTACK_SECRET_KEY=

# Telegram Bot Integration (Bot token for password reset & notification dispatches)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Gemini AI Integration (Server-side API key for support AI and image analysis)
GEMINI_API_KEY=

# Server Runtime Configuration
PORT=3000
ALLOWED_ORIGINS=https://omorfihub.com,https://staging.omorfihub.com

# --- FRONTEND CLIENT CONFIGURATION (PUBLICLY VISIBLE IN BROWSER) ---
# MUST BE PREFIXED WITH VITE_

# API Base URL (Optional: Leave empty for same-origin deployments like Vercel/Netlify rewrites)
# Set to custom API URL (e.g., https://api.omorfihub.com) if frontend and backend are hosted separately.
VITE_API_BASE_URL=

# Google Maps Platform (Public frontend key with domain restrictions)
VITE_GOOGLE_MAPS_API_KEY=

# Flutterwave Public Key (Used by client-side checkout)
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Paystack Public Key (Used by client-side checkout)
VITE_PAYSTACK_PUBLIC_KEY=

# Application Identity & Public Origin
VITE_APP_NAME="OmorfiHub"
VITE_APP_URL="https://omorfihub.com"
